# Copy to .env (git-ignored). Only needed for Sepolia.
# Deployer and test players are derived from this mnemonic (accounts 0 and 1).
MNEMONIC=
# Any Sepolia JSON-RPC endpoint. Alternatively set INFURA_API_KEY.
SEPOLIA_RPC_URL=
INFURA_API_KEY=
# Optional, for `npm run verify:sepolia`.
ETHERSCAN_API_KEY=
# Optional: a Zama relayer API key, if the testnet relayer starts requiring one.
ZAMA_FHEVM_API_KEY=
