# Which chain the app talks to. Must match a deployment synced from ../contracts/deployments.
VITE_CHAIN_ID=31337
# JSON-RPC endpoint for that chain.
VITE_RPC_URL=http://127.0.0.1:8545
# "mock" uses the Hardhat node's FHE mock; "relayer" uses Zama's relayer SDK (Sepolia).
VITE_FHE_MODE=mock
# Block explorer base URL for transaction links. Leave empty for local chains.
VITE_EXPLORER_URL=

# Local chains only: a funded dev key that tops up guest wallets, and the top-up amount in ETH.
# Never set these for a public network.
VITE_LOCAL_FAUCET_KEY=
VITE_LOCAL_FAUCET_AMOUNT=1
