# Public settings for the Sepolia build (`npm run build:sepolia`). No secrets belong here.
VITE_CHAIN_ID=11155111
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_FHE_MODE=relayer
VITE_EXPLORER_URL=https://sepolia.etherscan.io
VITE_LOCAL_FAUCET_KEY=
VITE_LOCAL_FAUCET_AMOUNT=
# The hosted site's gas drip (api/drip.js). Guests get test ETH from it, so nobody needs a faucet.
VITE_DRIP_URL=/api/drip
